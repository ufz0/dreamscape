# OpenAI-compatible upstream. These are the fallback for the first run: when the connections table
# is empty, this becomes a connection called "Default" and the settings below are read from here.
# Inference connections and their models are managed in the admin panel, so this section only
# matters until the first one is created there.
STRATA_BASE_URL=http://10.0.0.57:8080/v1
# Optional. Sent as "Authorization: Bearer <key>" only when set.
STRATA_API_KEY=
STRATA_MODEL=qwen3.8-flash-next

# Web app bind. 0.0.0.0 by default so the app is reachable from the network; use 127.0.0.1 for a
# machine-only instance. Past a trusted network, put it behind an HTTPS reverse proxy: the session
# cookie is only marked Secure when the request arrives over https.
HOST=0.0.0.0
PORT=8000

# auto | true | false. "auto" marks the cookie Secure when the request arrives over https, which
# is what a reverse proxy should report. Set true when the app is always served over https.
COOKIE_SECURE=auto
# Comma-separated proxy IPs whose X-Forwarded-For and X-Forwarded-Proto are trusted. Only these
# are read; anything else is taken from the connection. Empty means no proxy is trusted.
TRUSTED_PROXIES=

# The key for encrypting the secrets in the database (connection API keys). When this is not set,
# a key is generated once into data/secret.key with mode 600 and the path is logged at startup.
# Set it if you want the key outside the data folder, for example so a restore is reproducible.
# Generate one with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_SECRET_KEY=

# Runtime settings are not here: the global default limits, the run caps, the queue timeout, the
# default chat and dreaming models, the upload caps and allowed extensions, the PDF page limit, the
# API access switch and the per-key rate limit are in the admin panel, because they change while the
# app is running. Migrations run at startup and back up the database first.

# Accounts. Login lockout: 5 failures per username or IP per 10 minutes.
# Sessions last 30 days and slide; the password hash is argon2. These are fixed in
# accounts.py, there is nothing to set here.

# Time zone used for the day/week/month/year boundaries in the usage views.
# Everything is stored in UTC and aggregated in this zone; weeks start on Monday.
TIMEZONE=Europe/Vienna

# Optional tuning
DATA_DIR=./data
IDLE_MINUTES=60
MAX_TOOL_ITERATIONS=8
INDEX_MAX_LINES=150
PAGE_MAX_LINES=120

# Web tools (chat only; dreaming keeps the wiki tools). Without a key the duckduckgo provider is
# used, which needs no account. Brave is used only when BRAVE_API_KEY is set.
SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=
SEARCH_TIMEOUT=10
SEARCH_CACHE_MINUTES=10
SEARCH_RATE_LIMIT=20
SEARCH_RATE_LIMIT_MINUTES=10
WEB_TOOL_ITERATIONS=12
MAX_TOOL_ITERATIONS_CAP=16
WEB_FETCH_MAX_CHARS=24000
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_TIMEOUT=10
WEB_FETCH_MAX_REDIRECTS=3
# Off by default: a public name that resolves to a private or loopback address is refused.
WEB_FETCH_ALLOW_PRIVATE=false
WEB_USER_AGENT=Dreamscape/1.0

# When the dreaming job runs, for the scheduler service in docker-compose. A wall-clock time in
# TIMEZONE, so it moves with the changeover to winter time.
DREAM_TIME=03:00
